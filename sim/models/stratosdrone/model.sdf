<?xml version="1.0"?>
<!-- STRATOSDRONE rigid-body model. Mass/inertia mirror fc_core/test/sil_plant.c
     (the host SIL plant) so simulation results transfer. Body frame FLU.
     SPDX-License-Identifier: MIT -->
<sdf version="1.9">
  <model name="stratosdrone">
    <link name="base_link">
      <inertial>
        <mass>0.092</mass>
        <inertia>
          <ixx>1.1e-4</ixx><iyy>1.1e-4</iyy><izz>2.0e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="hull">
        <geometry><box><size>0.13 0.13 0.041</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Tello-style elongated narrow body: long along +x (forward), narrow
           in y. Camera bump at the nose, battery slab at the rear. -->
      <visual name="body">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><box><size>0.072 0.034 0.026</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="canopy">
        <pose>0.006 0 0.018 0 0.12 0</pose>
        <geometry><box><size>0.044 0.03 0.012</size></box></geometry>
        <material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.9 0.45 0.05 1</diffuse></material>
      </visual>
      <visual name="camera"><pose>0.034 0 0.006 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material></visual>
      <visual name="battery">
        <pose>-0.022 0 -0.013 0 0 0</pose>
        <geometry><box><size>0.03 0.026 0.013</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>

      <!-- four slim arms reaching diagonally to the motors at ±41.7 mm -->
      <visual name="arm_fr"><pose>0.0235 -0.0235 0 0 0 -0.785</pose>
        <geometry><box><size>0.05 0.009 0.006</size></box></geometry>
        <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>
      <visual name="arm_br"><pose>-0.0235 -0.0235 0 0 0 0.785</pose>
        <geometry><box><size>0.05 0.009 0.006</size></box></geometry>
        <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>
      <visual name="arm_bl"><pose>-0.0235 0.0235 0 0 0 -0.785</pose>
        <geometry><box><size>0.05 0.009 0.006</size></box></geometry>
        <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>
      <visual name="arm_fl"><pose>0.0235 0.0235 0 0 0 0.785</pose>
        <geometry><box><size>0.05 0.009 0.006</size></box></geometry>
        <material><ambient>0.18 0.18 0.2 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual>

      <visual name="motor_fr"><pose>0.0417 -0.0417 0.008 0 0 0</pose>
        <geometry><cylinder><radius>0.00425</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      <visual name="motor_br"><pose>-0.0417 -0.0417 0.008 0 0 0</pose>
        <geometry><cylinder><radius>0.00425</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      <visual name="motor_bl"><pose>-0.0417 0.0417 0.008 0 0 0</pose>
        <geometry><cylinder><radius>0.00425</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      <visual name="motor_fl"><pose>0.0417 0.0417 0.008 0 0 0</pose>
        <geometry><cylinder><radius>0.00425</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>

      <visual name="prop_fr"><pose>0.0417 -0.0417 0.0185 0 0 0</pose>
        <geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.9 0.45 0.05 0.5</ambient><diffuse>0.9 0.45 0.05 0.5</diffuse></material>
        <transparency>0.45</transparency></visual>
      <visual name="prop_br"><pose>-0.0417 -0.0417 0.0185 0 0 0</pose>
        <geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 0.5</ambient><diffuse>0.2 0.2 0.22 0.5</diffuse></material>
        <transparency>0.45</transparency></visual>
      <visual name="prop_bl"><pose>-0.0417 0.0417 0.0185 0 0 0</pose>
        <geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 0.5</ambient><diffuse>0.2 0.2 0.22 0.5</diffuse></material>
        <transparency>0.45</transparency></visual>
      <visual name="prop_fl"><pose>0.0417 0.0417 0.0185 0 0 0</pose>
        <geometry><cylinder><radius>0.0381</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.9 0.45 0.05 0.5</ambient><diffuse>0.9 0.45 0.05 0.5</diffuse></material>
        <transparency>0.45</transparency></visual>
    </link>
  </model>
</sdf>
