<?xml version="1.0"?>
<!-- Three-drone swarm world (127.0.0.2 / .3 / .4) for TelloSwarm scripts.
     SPDX-License-Identifier: MIT -->
<sdf version="1.9">
  <world name="swarm_3">
    <physics name="fast" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>4</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.80665</gravity>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://stratosdrone</uri><name>drone_1</name><pose>0 -1 0.025 0 0 0</pose>
      <plugin filename="StratosFcSystem" name="stratos::StratosFcSystem">
        <bind_ip>127.0.0.2</bind_ip><seed>7</seed>
      </plugin>
    </include>
    <include>
      <uri>model://stratosdrone</uri><name>drone_2</name><pose>0 0 0.025 0 0 0</pose>
      <plugin filename="StratosFcSystem" name="stratos::StratosFcSystem">
        <bind_ip>127.0.0.3</bind_ip><seed>11</seed>
      </plugin>
    </include>
    <include>
      <uri>model://stratosdrone</uri><name>drone_3</name><pose>0 1 0.025 0 0 0</pose>
      <plugin filename="StratosFcSystem" name="stratos::StratosFcSystem">
        <bind_ip>127.0.0.4</bind_ip><seed>13</seed>
      </plugin>
    </include>
  </world>
</sdf>
